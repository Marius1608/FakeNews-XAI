# Copy this file to .env and fill in your values.
# .env is git-ignored; .env.example is tracked.

# Wikidata SPARQL endpoint (public, no API key required)
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql

# spaCy NLP models to load (comma-separated list)
# The first value in SPACY_DEFAULT_MODEL is used as the active model.
# Available options: en_core_web_trf (transformer, most accurate),
#   en_core_web_lg (large), en_core_web_sm (small, fastest)
SPACY_MODELS=en_core_web_trf,en_core_web_lg
SPACY_DEFAULT_MODEL=en_core_web_trf

# Ollama LLM models to pull and expose via /models (comma-separated list)
# LLM_DEFAULT_MODEL is the model selected by default in the UI.
LLM_MODELS=sciphi/triplex,fakenews-ner
LLM_DEFAULT_MODEL=sciphi/triplex

# Ollama server URL (change if Ollama runs on a remote host)
OLLAMA_HOST=http://localhost:11434
# Seconds to wait for an Ollama inference response before timing out
OLLAMA_TIMEOUT_SECONDS=120

# Comma-separated origins allowed to call the FastAPI backend (CORS)
CORS_ORIGINS=http://localhost:3000

# NewsAPI key — only needed for the demo notebook, not the main pipeline
# NEWSAPI_KEY=your_key_here

# Neo4j (optional — for persistent cross-article analysis)
# Start with: docker run -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:community
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_ENABLED=false
